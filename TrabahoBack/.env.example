# Copy this file to .env and adjust as needed.
# These defaults match docker-compose.yml and work out of the box for local dev.

# Database (used by both the postgres and backend services in docker-compose.yml)
DB_NAME=admin
DB_USERNAME=admin
DB_PASSWORD=password123456789
DB_PORT=5433

# JWT
# Generate your own secret with: openssl rand -base64 32
JWT_SECRET=zDcAomCXHzjqaM6HC7azQEF5J05dzB9BjKrGIVbeSOg=
JWT_EXPIRATION_MS=86400000
# How long a refresh token stays valid (ms). Default: 7 days.
JWT_REFRESH_EXPIRATION_MS=604800000
