# Copy this file to .env and fill in real values. DB_PASSWORD and JWT_SECRET
# are required — docker-compose and the backend will refuse to start without them.

# Database (used by both the postgres and backend services in docker-compose.yml)
DB_NAME=admin
DB_USERNAME=admin
# Set your own password
DB_PASSWORD=
DB_PORT=5433

# JWT
# Generate your own secret with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
# How long a refresh token stays valid (ms). Default: 7 days.
JWT_REFRESH_EXPIRATION_MS=604800000
